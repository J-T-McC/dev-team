#!/usr/bin/env python3
"""Heavy jobs take turns (workflow/orca.md § Machine resources): a few machine-wide slots, critical path first.

  slot run <label> [--prio N] [--pool <name>] -- <command...>   wait for a free slot, run the command, free the
                                                                slot when it ends
  slot status                                   who holds a slot and who waits, in every pool

Lower --prio goes first (default 5; the critical path takes 1); the same prio is first come, first served.
DEV_TEAM_SLOTS sets the number of slots (default 2), DEV_TEAM_SLOT_WAIT the longest wait in minutes (default 60;
past it, exit 75). A slot frees itself when its holder exits, however it exits. Stopping `slot` (SIGTERM, SIGINT,
SIGHUP) stops the command it runs and that command's children too, so a server never outlives its slot.

A pool is a separate set of slots, so long-lived jobs never block test runs: --pool containers holds a slot while a
container runs — `slot run db --pool containers -- docker compose up db` (run it in the background), or for one
already started detached, `slot run db --pool containers -- docker wait <container>`. DEV_TEAM_SLOTS_<POOL> sets a
pool's size (default 2).
"""
import fcntl, os, re, signal, subprocess, sys, time
from pathlib import Path

BASE = Path(os.environ.get("DEV_TEAM_SLOT_DIR") or Path.home() / ".cache" / "dev-team" / "slots")
DIR, SLOTS = BASE, int(os.environ.get("DEV_TEAM_SLOTS", "2"))


def use_pool(name):
    """Point DIR and SLOTS at a pool: the default pool is the base directory, others a folder in it."""
    global DIR, SLOTS
    if name in (None, "", "default"):
        DIR, SLOTS = BASE, int(os.environ.get("DEV_TEAM_SLOTS", "2"))
        return "default"
    name = re.sub(r"[^a-z0-9_]", "_", name.lower())
    DIR, SLOTS = BASE / "pools" / name, int(os.environ.get(f"DEV_TEAM_SLOTS_{name.upper()}", "2"))
    return name
WAIT_MIN = float(os.environ.get("DEV_TEAM_SLOT_WAIT", "60"))
POLL = float(os.environ.get("DEV_TEAM_SLOT_POLL", "2"))


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def line():
    """Live waiters, first in line first; entries of dead waiters are removed."""
    out = []
    for f in (DIR / "wait").glob("*"):
        prio, t, pid, label = f.name.split("-", 3)
        if alive(int(pid)):
            out.append((int(prio), int(t), f, label))
        else:
            f.unlink(missing_ok=True)
    return sorted(out)


def take(i):
    """A held lock on slot i, or None. The OS drops the lock when the holder exits."""
    fd = os.open(DIR / f"slot-{i}.lock", os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return fd
    except BlockingIOError:
        os.close(fd)
        return None


def run(argv):
    if "--" not in argv or argv.index("--") < 1 or argv.index("--") == len(argv) - 1:
        sys.exit(__doc__)
    cmd, head = argv[argv.index("--") + 1:], argv[:argv.index("--")]
    label = re.sub(r"[^A-Za-z0-9._]", "_", head[0])
    prio = int(head[head.index("--prio") + 1]) if "--prio" in head else 5
    pool = use_pool(head[head.index("--pool") + 1] if "--pool" in head else None)
    where = "" if pool == "default" else f" in pool {pool}"
    (DIR / "wait").mkdir(parents=True, exist_ok=True)
    me = DIR / "wait" / f"{prio:03d}-{time.time_ns()}-{os.getpid()}-{label}"
    me.touch()
    start, said, fd = time.time(), False, None
    try:
        while fd is None:
            waiting = line()
            if waiting and waiting[0][2] == me:
                for i in range(SLOTS):
                    fd = take(i)
                    if fd is not None:
                        break
                if fd is not None:
                    break
            if not said:
                place = next((n for n, w in enumerate(waiting, 1) if w[2] == me), 1)
                print(f"slot: {label} waiting, {place} in line for {SLOTS} slot(s){where}", file=sys.stderr)
                said = True
            if time.time() - start > WAIT_MIN * 60:
                print(f"slot: {label} gave up after {WAIT_MIN:g} min", file=sys.stderr)
                sys.exit(75)
            time.sleep(POLL)
    finally:
        me.unlink(missing_ok=True)
    (DIR / f"slot-{i}.info").write_text(f"{label}\t{os.getpid()}\t{time.strftime('%H:%M:%S')}\n")
    print(f"slot: {label} has slot {i + 1} of {SLOTS}{where}", file=sys.stderr)
    sys.exit(supervise(cmd))


def tree(pid):
    """pid and every process below it, parents first."""
    kids = {}
    out = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True).stdout
    for row in out.splitlines():
        c, _, p = row.strip().partition(" ")
        kids.setdefault(int(p), []).append(int(c))
    found, todo = [], [pid]
    while todo:
        n = todo.pop()
        found.append(n)
        todo += kids.get(n, [])
    return found


def supervise(cmd):
    """Run cmd; a signal to slot goes to cmd and everything under it (a pkill that matches slot's own command line,
    or a stopped background task), and anything still running a few seconds later is killed. The wait polls, so the
    handler never meets a wait already in progress."""
    child = subprocess.Popen(cmd)
    stopping = {}

    def stop(sig, _frame):
        if not stopping:
            stopping.update(sig=sig, procs=tree(child.pid),
                            deadline=time.time() + float(os.environ.get("DEV_TEAM_SLOT_GRACE", "5")))
        for pid in stopping["procs"]:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    while True:
        rc = child.poll()
        if not stopping:
            if rc is not None:
                return rc
        else:
            rest = [p for p in stopping["procs"][1:] if alive(p)]
            if rc is not None and not rest:
                return 128 + stopping["sig"]
            if time.time() >= stopping["deadline"]:
                for pid in ([child.pid] if rc is None else []) + rest:
                    try:
                        os.kill(pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                child.wait()
                return 128 + stopping["sig"]
        time.sleep(0.1)


def status():
    pools = sorted(p.name for p in (BASE / "pools").glob("*") if p.is_dir()) if (BASE / "pools").is_dir() else []
    for name in ["default"] + pools:
        use_pool(name)
        if name != "default":
            print(f"pool {name}:")
        pool_status("  " if name != "default" else "")


def pool_status(indent):
    (DIR / "wait").mkdir(parents=True, exist_ok=True)
    for i in range(SLOTS):
        fd = take(i)
        if fd is not None:
            os.close(fd)
            print(f"{indent}slot {i + 1}: free")
        else:
            info = (DIR / f"slot-{i}.info")
            label, pid, since = (info.read_text().split("\t") + ["?"] * 3)[:3] if info.exists() else ("?", "?", "?")
            print(f"{indent}slot {i + 1}: {label} (pid {pid}, since {since.strip()})")
    for n, (prio, _, _, label) in enumerate(line(), 1):
        print(f"{indent}waiting {n}: {label} (prio {prio})")


if __name__ == "__main__":
    if sys.argv[1:2] == ["run"]:
        run(sys.argv[2:])
    elif sys.argv[1:2] in (["status"], []):
        status()
    else:
        sys.exit(__doc__)
