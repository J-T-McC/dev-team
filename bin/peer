#!/usr/bin/env python3
"""Coordinator helpers for the Orca runtime (workflow/orca.md): named peer homes, a fresh session per task.

  peer dispatch [--keep] <home> <role> <spec text or file> [--model <model>] [--effort <effort>]
                [--worktree <selector> [--name <name>] [--base-branch <ref>]] [--on <environment> [--repo <selector>]]
                [--title <text>] [--owner]   --owner: the Owner asked for it, so it runs outside working hours too
  peer wrap-up           working hours are over: tell every working peer to finish at its next clean point
  peer tell <home> <subject> <body> [--reply <message-id>] [--wait]   send, then nudge in the background (--wait: here)
  peer switch [<home>...]          give live peers the project's current model and effort now (default: all)
  peer sleep <home>... | --idle    close idle peers' sessions to free the machine; the next dispatch wakes them
  peer adopt <home> <role> <terminal> [--on <environment>]   make a terminal started outside peer a home
  peer watch [minutes]   wait, at no token cost, for a peer message, STUCK, LIMIT, SIZE, STALL, NUDGE, a PR change, or the
                         time limit (default 15), or working hours starting or ending (CLOSED, OPEN; while
                         closed, the time limit never wakes you); then report status.md drift and Owner-board drift
  peer pending [--full]  the unacknowledged batch: peer reports not handled yet (exit 1 if any); --full: uncut
  peer ack <delivery>    acknowledge that batch, unless messages joined it after you read it (then shows them, exit 1)
  peer pr <home> <PR number or URL>... [--repo <owner/name>] | peer pr --drop <PR>...   who owns which PR
  peer prs [--sweep]     the team's PRs and owners; --sweep: open PRs with a failing check or a conflict (exit 1 if any)
  peer sizes             each peer's context size against the project's Peer size limit
  peer limits [--clear [<model>]]  models out of usage, as the watcher saw them
  peer list [--board-json <dir>]   homes, roles, models, worktrees, current task; or Owner-board peers rows as files
  peer team [--create | --rename <home> <name>]   the homes Team setup names, with each one's name; --create makes
                         every home's worktree now (no session until its first task); --rename gives a home a new name
  peer board-stamp [--rows <dir>]  record that the Owner board matches <ws>/status.md now (workflow/board.md)
  peer hook prompt|stop  the coordinator's guard hooks (hooks/coordinator.sh)

Run from a peer's own terminal, only sizes, limits, list, prs and hook work: the rest are the coordinator's.

Homes, the team's Run, and its PRs are machine-local state: <git common dir>/dev-team/peers.json.
"""
import copy, fcntl, hashlib, json, os, random, re, shlex, shutil, signal, subprocess, sys, time
from datetime import date, timedelta
from pathlib import Path

STALL_MIN = float(os.environ.get("DEV_TEAM_STALL_MIN", "20"))
STUCK_MIN = float(os.environ.get("DEV_TEAM_STUCK_MIN", "2"))
POLL_SEC = float(os.environ.get("DEV_TEAM_WATCH_POLL", "30"))
STEP_SEC = float(os.environ.get("DEV_TEAM_STEP_SEC", "2"))
CLOSE_SEC = float(os.environ.get("DEV_TEAM_CLOSE_SEC", "10"))  # a session just past its last turn takes a moment to exit
CLOSE_RESEND_SEC = float(os.environ.get("DEV_TEAM_CLOSE_RESEND_SEC", "3"))  # a close sent as the session exits can be dropped
RECHECK_SEC = float(os.environ.get("DEV_TEAM_RECHECK_SEC", "5"))
PR_POLL_MIN = float(os.environ.get("DEV_TEAM_PR_POLL", "5"))
EFFORTS = ("low", "medium", "high", "xhigh", "max")
ADVISOR_ROLES = ("product-manager", "principal-engineer")
ROLE_LINE = ("You are the dev-team {role} peer [dev-team home {home}]. If the dev-team:{role} skill is not loaded "
             "in this conversation, invoke it first. Follow the peer rules in the dev-team workflow/orca.md § Peers: "
             "ask for any decision or go with your preamble's `ask` command, never in a status message. Read messages with "
             "`orca orchestration check`, then `check --ack <deliveryId>` and check again until it is empty: an "
             "unacknowledged batch hides the ones behind it.")
ADVISOR_LINE = (" You have an advisor model: use it for hard questions other roles bring you and hard calls in your "
                "own plans, not for routine work.")
# A peer's screen while it still runs something: a turn, or a background shell, monitor, or agent.
# Busy: the working line (a spinner, a verb, an elapsed time: "✻ Pondering… (1m 12s · …)"), or a background shell,
# monitor or other job that closing the session would kill. The status bar's "← 1 agent" is shown at an idle
# prompt too, so it is not a job.
BUSY = re.compile(r"\d+ (?:background )?(?:shells?|monitors?|agents?)\b|(?:shells?|monitors?|agents?),?[^\n]{0,30}"
                  r"still running|still running in (?:the )?background|esc to interrupt"
                  r"|^\s*[^\w\s]\s*\w[\w-]*(?:…|\.\.\.)\s*\((?:\d+[hms]\s*)+", re.I | re.M)
AGENTS_BAR = re.compile(r"←\s*\d+\s+agents?\b")
LIMIT = re.compile(r"hit your ([\w .-]{0,30}?) ?limit[^\n]*|usage limit reached[^\n]*|limit reached\s*[·∙•][^\n]*", re.I)
STUCK = re.compile(r"API Error[^\n]*|\S*overloaded_error[^\n]*", re.I)
RESUME = "Resume this session with"  # Claude prints it on exit: what is above it on the screen is a dead session
MONTHS = "jan feb mar apr may jun jul aug sep oct nov dec".split()
ROLE_RANK = {"product-manager": 1, "designer": 2, "principal-engineer": 3, "senior-developer": 4, "reviewer": 5}
# Each home gets a first name the first time it's used, shown beside its role (workflow/orca.md § Topology).
NAMES = ("Ada", "Alma", "Ari", "Bea", "Bob", "Bruno", "Cal", "Cleo", "Dara", "Eli", "Elsa", "Esme", "Finn", "Gus",
         "Hana", "Hugo", "Ida", "Ines", "Iris", "Ivo", "Jada", "Jonah", "Juno", "Kai", "Kit", "Lena", "Leo", "Lou",
         "Mae", "Mara", "Maya", "Milo", "Nell", "Nia", "Nico", "Noor", "Ola", "Omar", "Otis", "Pablo", "Pia", "Quinn",
         "Rafa", "Remy", "Rita", "Rosa", "Ruth", "Sana", "Sandra", "Saul", "Sol", "Tess", "Theo", "Uma", "Vera",
         "Wren", "Yara", "Yuki", "Zane", "Zora")
ROLE_WORD = {"product-manager": "product manager", "designer": "designer", "principal-engineer": "lead engineer",
             "senior-developer": "developer", "reviewer": "reviewer"}
HOME_ROLE = (("dt-product", "product-manager"), ("dt-designer", "designer"), ("dt-architect", "principal-engineer"),
             ("dt-reviewer", "reviewer"), ("dt-dev", "senior-developer"))
FAIL = ("FAILURE", "TIMED_OUT", "STARTUP_FAILURE", "ERROR", "ACTION_REQUIRED")
PR_URL = re.compile(r"github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def git(*a):
    p = subprocess.run(["git", *a], capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else ""


ROOT = Path(git("rev-parse", "--show-toplevel") or ".")
STATE = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir") or ".git") / "dev-team"
REG = STATE / "peers.json"
LIMITS = STATE / "limits.json"
WATCH_PID = STATE / "watch.pid"
LOCK = STATE / "coordinator.lock"
BOARD = STATE / "board.json"
CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
PLUGIN = Path(__file__).resolve().parent.parent


def orca(*args, timeout=120):
    """Run an orca command with --json; returns (parsed JSON or {}, raw output)."""
    try:
        p = subprocess.run(["orca", *args, "--json"], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return {}, str(e)
    out = p.stdout
    try:
        return json.loads(out[out.find("{"):]), out + p.stderr
    except ValueError:
        return {}, out + p.stderr


def find(o, key):
    """First non-empty value for key anywhere in a JSON tree."""
    if isinstance(o, dict):
        if o.get(key) not in (None, ""):
            return o[key]
        o = list(o.values())
    if isinstance(o, list):
        for v in o:
            r = find(v, key)
            if r is not None:
                return r
    return None


SEEN = {}  # id(registry) -> the registry as this process last read or wrote it


def load():
    reg = json.loads(REG.read_text()) if REG.exists() else {"run": None, "homes": {}}
    SEEN[id(reg)] = copy.deepcopy(reg)
    return reg


def save(reg):
    """Write back only what this process changed, under a lock. The coordinator runs peer commands side by side
    (dispatches in the background), and a whole-file write would undo another command's change to another home."""
    STATE.mkdir(parents=True, exist_ok=True)
    was = SEEN.get(id(reg)) or {}
    with open(STATE / "peers.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cur = json.loads(REG.read_text()) if REG.exists() else {"run": None, "homes": {}}
        for k in set(reg) | set(was):
            if k not in reg:
                cur.pop(k, None)
                continue
            new, old = reg[k], was.get(k)
            if new == old:
                continue
            if isinstance(new, dict) and isinstance(old, dict) and isinstance(cur.get(k), dict):
                for n in set(new) | set(old):  # one level down: one home, one PR record
                    if n not in new:
                        cur[k].pop(n, None)
                    elif new[n] != old.get(n):
                        cur[k][n] = new[n]
            else:
                cur[k] = new
        tmp = REG.with_name(REG.name + ".tmp")
        tmp.write_text(json.dumps(cur, indent=2) + "\n")
        os.replace(tmp, REG)
    SEEN[id(reg)] = copy.deepcopy(reg)


def project_text():
    return "\n".join((ROOT / n).read_text() for n in ("CLAUDE.local.md", "CLAUDE.md") if (ROOT / n).exists())


def size_limit():
    m = re.search(r"Peer size limit:\s*(\d+)\s*k", project_text(), re.I)
    return int(m.group(1)) if m else 400


# --- launch settings (workflow/orca.md § Launch settings) ------------------------------------------------------------

def setting(name):
    """A setting on the project's Runtime line; "" when absent, none, or off."""
    line = re.search(r"\*\*Runtime: Orca\.\*\*(.*)", project_text())
    m = re.search(rf"\b{name}:\s*(.+?)\s*(?:\.\s|\.?$)", line.group(1) if line else "", re.I)
    v = m.group(1).strip(" `") if m else ""
    return "" if v.lower() in ("none", "off") else v


def model_effort(value):
    """<model>[/<effort>] or <effort> -> (model, effort)."""
    value = value.strip(" `.")
    if value.lower() in EFFORTS:
        return "", value.lower()
    model, _, effort = value.partition("/")
    return model.strip(), effort.strip().lower()


def role_override(role):
    """<role>: <model>[/<effort>] or <role>: <effort>, from the Role models line (workflow/overview.md)."""
    m = re.search(r"\*\*Role models:\*\*(.*)", project_text())
    for part in (m.group(1).split(";") if m else []):
        name, _, value = part.partition(":")
        if name.strip(" `") == role and value.strip(" `."):
            return model_effort(value)
    return "", ""


def agent_effort(role):
    f = PLUGIN / "agents" / f"{role}.md"
    m = re.search(r"^effort:\s*(\S+)", f.read_text(), re.M) if f.exists() else None
    return m.group(1) if m else ""


def until(entry, today):
    """The last day a recorded limit holds: its reset day, the day it was seen for a reset later that day, or None."""
    after = re.search(r"reset\w*\s*(.*)", entry["text"], re.I)
    after = after.group(1) if after else ""
    m = re.search(r"\b([A-Za-z]{3})[a-z]*\.?\s+(\d{1,2})\b", after)
    if m and m.group(1).lower() in MONTHS:
        try:
            d = date(today.year, MONTHS.index(m.group(1).lower()) + 1, int(m.group(2)))
        except ValueError:
            return None
        return d.replace(year=d.year + 1) if d < today - timedelta(days=180) else d
    if re.search(r"\d{1,2}(:\d\d)?\s*[ap]m|\d{1,2}:\d\d", after, re.I):
        return date.fromisoformat(entry["seen"])
    return None


def limits():
    """{model family: {text, seen}} still in force; expired ones are dropped."""
    lim = json.loads(LIMITS.read_text()) if LIMITS.exists() else {}
    today = date.today()
    live = {k: v for k, v in lim.items() if until(v, today) is None or until(v, today) >= today}
    if live != lim:
        STATE.mkdir(parents=True, exist_ok=True)
        LIMITS.write_text(json.dumps(live, indent=2) + "\n")
    return live


def limited(model, lim):
    return next((f for f in lim if f in model.lower()), None)


def launch_plan(role, model_once="", effort_once=""):
    """(model, effort, claude flags, notes) for a new session of this role. Never the global default.
    model_once / effort_once: a dispatch's own choice for this one task."""
    team_model, team_effort = model_effort(setting("Team model"))
    model, effort = role_override(role)
    model, effort = model_once or model, effort_once or effort
    model = model or team_model or die('no Team model: add "Team model: <model>" to the project\'s Runtime line '
                                       "(workflow/orca.md § Launch settings)")
    effort = effort or team_effort or agent_effort(role) or die(f'no effort for {role}: name one on the Role models line')
    fallback, lim, notes = setting("Fallback model"), limits(), []
    out = limited(model, lim)
    if out:
        if not fallback or limited(fallback, lim):
            die(f"{model} is out of usage ({lim[out]['text']}) and there is no usable Fallback model. "
                "Name one on the Runtime line, or clear the limit with `peer limits --clear`.")
        notes.append(f"{model} is out of usage ({lim[out]['text']}): launching on the fallback, {fallback}")
        model, fallback = fallback, ""
    flags = ["--model", model, "--effort", effort]
    if fallback and fallback != model:
        flags += ["--fallback-model", fallback]
    adv_model, _, roles = setting("Advisor").partition(" for ")
    roles = [r.strip() for r in roles.split(",") if r.strip()] or ADVISOR_ROLES
    if adv_model.strip() and role in roles:
        if limited(adv_model, lim):
            notes.append(f"advisor {adv_model.strip()} is out of usage: launching without it")
        else:
            flags += ["--settings", json.dumps({"advisorModel": adv_model.strip()})]
    return model, effort, flags, notes


# --- Orca helpers ---------------------------------------------------------------------------------------------------

def bind(reg):
    """The team's Run, created on first use; this terminal is bound to it so check and --ack work.
    The caller is recorded as the coordinator, whose session the guard hooks watch."""
    me = {"terminal": os.environ.get("ORCA_TERMINAL_HANDLE"), "session": os.environ.get("CLAUDE_CODE_SESSION_ID")}
    peers = {h["terminal"] for h in reg["homes"].values() if h.get("terminal")}
    if (me["terminal"] or me["session"]) and me["terminal"] not in peers:
        reg["coordinator"] = me
    if not reg.get("run"):
        d, raw = orca("orchestration", "run-create", "--objective", f"dev-team: {ROOT.name}")
        m = re.search(r"run_[0-9a-f]+", json.dumps(d) if d else raw)
        if not m:
            die("run-create failed:\n" + raw[:800])
        reg["run"] = m.group(0)
    elif me["terminal"] not in peers:  # a peer's terminal taking the Run would unbind the coordinator's
        orca("orchestration", "run-use", "--id", reg["run"])
    save(reg)
    return reg["run"]


def worker(dispatch):
    return (orca("orchestration", "worker-show", "--dispatch", dispatch)[0].get("result") or {}) if dispatch else {}


ENDED = ("settled", "failed", "abandoned", "cancelled", "canceled")


def settled(w):
    """The dispatch is over: settled, or failed or abandoned at any stage (a start that fails at agent readiness never
    reaches settled, and would otherwise count as working forever)."""
    p = w.get("projection") or {}
    seen = [(w.get("worker") or {}).get("stage"), (w.get("worker") or {}).get("state"),
            (w.get("dispatch") or {}).get("status"), (p.get("stage") or {}).get("detail")]
    for k in ("worker", "dispatch"):
        v = p.get(k)
        seen.append((v.get("state") or v.get("status")) if isinstance(v, dict) else v)
    return any(isinstance(v, str) and v.lower() in ENDED for v in seen)


def working(h):
    w = worker(h.get("dispatch"))
    return bool(w) and not settled(w)


def on(h):
    """The --environment flag for a home on a remote Orca server; terminal handles belong to the server that issued them."""
    return ["--environment", h["env"]] if h and h.get("env") else []


def term_info(h):
    """The home's terminal metadata (agentIdentity, worktreePath, …), or {} when it is gone — closed, or orphaned."""
    term = (h or {}).get("terminal")
    d, _ = orca("terminal", "show", "--terminal", term, *on(h)) if term else ({}, "")
    t = (find(d, "terminal") or {}) if d.get("ok") else {}
    return {} if t.get("orphaned") else t


def screen(h):
    tail = find(orca("terminal", "read", "--terminal", h["terminal"], "--screen", *on(h))[0], "tail")
    return tail if isinstance(tail, list) else []


def live_screen(h):
    """The screen below the last session exit: a dead session's old status line is not work."""
    lines = screen(h)
    cut = max((i for i, line in enumerate(lines) if RESUME in line), default=-1)
    return lines[cut + 1:]


_SCAN = [0.0, {}]


def local_procs(term, fresh=False):
    """[(pid, args)] of this machine's processes started in that terminal: they inherit its ORCA_TERMINAL_HANDLE.
    One scan serves a second's worth of calls, unless fresh."""
    if fresh or time.time() - _SCAN[0] > 1:
        by = {}
        try:
            if Path("/proc/self/environ").exists():
                for d in Path("/proc").glob("[0-9]*"):
                    try:
                        env = (d / "environ").read_bytes().split(b"\0")
                        handle = next((e[21:].decode() for e in env if e.startswith(b"ORCA_TERMINAL_HANDLE=")), None)
                        if handle:
                            args = (d / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="ignore")
                            by.setdefault(handle, []).append((int(d.name), args.strip()))
                    except (OSError, ValueError):
                        continue
            else:
                ps = lambda *a: subprocess.run(["ps", "-A", "-ww", *a, "-o", "pid=,args="], capture_output=True,
                                               text=True, timeout=30).stdout.splitlines()
                args = dict((int(p), a) for p, a in (line.split(None, 1) for line in ps() if len(line.split(None, 1)) == 2))
                for line in ps("-E"):
                    pid, _, rest = line.strip().partition(" ")
                    m = re.search(r"(?:^|\s)ORCA_TERMINAL_HANDLE=(\S+)", rest)
                    if m and pid.isdigit():
                        by.setdefault(m.group(1), []).append((int(pid), args.get(int(pid), "").strip()))
        except (OSError, subprocess.TimeoutExpired, ValueError):
            by = {}
        _SCAN[:] = [time.time(), by]
    return [(p, a) for p, a in _SCAN[1].get(term, []) if p != os.getpid()]


def is_claude(args):
    """A Claude Code process: run as claude, or by an interpreter (node …/claude)."""
    names = {"claude", os.path.basename((shlex.split(os.environ.get("DEV_TEAM_CLAUDE", "claude")) or ["claude"])[0])}
    return any(os.path.basename(w) in names for w in args.split()[:2]) or "@anthropic-ai/claude-code" in args


def session_alive(h):
    """Whether the home's Claude session still runs, when this machine can tell (a local terminal); else None."""
    if h.get("env") or not h.get("terminal"):
        return None
    procs = local_procs(h["terminal"])
    return any(is_claude(a) for _, a in procs) if procs else None


def busy(h):
    if session_alive(h) is False:
        return None
    m = BUSY.search(AGENTS_BAR.sub("", "\n".join(live_screen(h)[-12:])))
    return m.group(0) if m else None


def send(h, text):
    orca("terminal", "send", "--terminal", h["terminal"], "--text", text, "--enter", *on(h))


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def mcp_names():
    """What an MCP server process looks like: "mcp" in its command, or a server named in the project's .mcp.json."""
    names = ["mcp"]
    try:
        servers = json.loads((ROOT / ".mcp.json").read_text()).get("mcpServers") or {}
    except (OSError, ValueError):
        servers = {}
    launchers = {"npx", "node", "uvx", "uv", "python", "python3", "bash", "sh", "docker", "deno", "bun", "bunx", "pnpm"}
    for v in servers.values():
        words = [os.path.basename(v.get("command") or "")] + [a for a in v.get("args") or [] if not a.startswith("-")]
        name = next((w for w in words if w and w not in launchers and w != "run"), "")
        if name:
            names.append(name)
    return names


def session_caches(h):
    """The paths in the peer's worktree that the Runtime line's Session caches setting names."""
    wt = Path(h.get("worktree") or "")
    if h.get("env") or not wt.is_dir():
        return []
    root, found = wt.resolve(), []
    for pat in (p.strip(" `") for p in setting("Session caches").split(",")):
        if not pat or pat.startswith(("/", "~")):
            continue
        for m in wt.glob(pat):
            r = m.resolve()
            if root in r.parents and ".git" not in r.relative_to(root).parts:
                found.append(m)
    return found


def short(args):
    """A process's command in a few words, without long paths."""
    return " ".join(os.path.basename(w) if "/" in w else w for w in args.split()[:6])[:90]


def cwds(pids):
    """{pid: working directory} for the processes this machine can tell."""
    out = {}
    if Path("/proc/self/cwd").exists():
        for p in pids:
            try:
                out[p] = os.readlink(f"/proc/{p}/cwd")
            except OSError:
                pass
        return out
    try:
        lines = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fn", "-p", ",".join(map(str, pids))], capture_output=True,
                               text=True, timeout=30).stdout.splitlines() if pids else []
    except (OSError, subprocess.TimeoutExpired):
        return out
    pid = None
    for line in lines:
        if line[:1] == "p" and line[1:].isdigit():
            pid = int(line[1:])
        elif line[:1] == "n" and pid:
            out[pid] = line[1:]
    return out


def from_worktree(procs, h):
    """The processes among procs that the peer started for its work: run in its worktree, or naming it. A machine-wide
    service the session happened to start (Docker Desktop, say) inherits the terminal but runs from its own folder:
    stopping it would stop it for everyone."""
    wt = h.get("worktree")
    if not wt:
        return []
    roots = {str(Path(wt)).rstrip("/"), os.path.realpath(wt)}
    named = re.compile("|".join(re.escape(r) for r in roots) + r"(?=/|\s|$)")
    where = cwds([p for p, _ in procs])
    return [(p, a) for p, a in procs if named.match(where.get(p, "")) or named.search(a)]


def cleanup(home, h, term):
    """Stop the MCP servers a closed session left running, name anything else it left, and clear its session caches.
    Only what the peer started from its worktree counts."""
    if h.get("env"):
        return
    time.sleep(STEP_SEC)
    left = from_worktree(local_procs(term, fresh=True), h)
    names = mcp_names()
    mcp = [(p, a) for p, a in left if any(n.lower() in a.lower() for n in names)]
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for p, _ in mcp:
            try:
                os.kill(p, sig)
            except OSError:
                pass
        if mcp and sig == signal.SIGTERM:
            time.sleep(1)
        mcp_left = [x for x in mcp if alive(x[0])]
        if not mcp_left:
            break
    if mcp:
        print(f"{home}: stopped {len(mcp)} MCP server process(es) its session left running: "
              + ", ".join(f"{p} {short(a)}" for p, a in mcp))
    others = [(p, a) for p, a in left if (p, a) not in mcp and alive(p)]
    if others:
        print(f"{home}: still running from its closed session — close each unless something needs it: "
              + "; ".join(f"{p} {short(a)}" for p, a in others))
    for path in session_caches(h):
        shutil.rmtree(path, ignore_errors=True) if path.is_dir() and not path.is_symlink() else path.unlink(missing_ok=True)
        print(f"{home}: cleared {path}")


# Roles whose own worktree sits on the default branch between tasks: document roles never branch, and a reviewer
# that tested a PR head detached would otherwise start its next session on that commit's older CLAUDE.md.
BASE_ROLES = ("product-manager", "designer", "principal-engineer", "reviewer")


def refresh_worktree(home, path):
    """Before a BASE_ROLES task, the home's own worktree (named after the home, as Team setup makes them) moves to the
    default branch's latest commit, so the new session loads the current CLAUDE.md and reads current code
    (workflow/orca-recommended.md § Roles and git). Left alone with uncommitted changes, or with
    commits that are on no remote branch and not in the default branch."""
    if Path(path).name != home or not Path(path).is_dir():
        return None
    g = lambda *a: git("-C", path, *a)
    if subprocess.run(["git", "-C", path, "status", "--porcelain"], capture_output=True, text=True).stdout.strip():
        return f"{home}'s worktree has uncommitted changes, so it stays at its commit"
    g("fetch", "-q", "origin")
    base = g("rev-parse", "--abbrev-ref", "origin/HEAD") or \
        next((b for b in ("origin/main", "origin/master") if g("rev-parse", "-q", "--verify", b)), "") or \
        git("-C", str(ROOT), "symbolic-ref", "--short", "HEAD")
    if not base:
        return None
    head, tip = g("rev-parse", "HEAD"), g("rev-parse", base)
    if not tip or head == tip:
        return None
    ancestor = subprocess.run(["git", "-C", path, "merge-base", "--is-ancestor", "HEAD", base]).returncode == 0
    if not ancestor and not g("branch", "-r", "--contains", "HEAD"):
        return f"{home}'s worktree has commits that are on no remote branch, so it stays at its commit"
    if subprocess.run(["git", "-C", path, "checkout", "-q", "--detach", base], capture_output=True).returncode:
        return f"{home}'s worktree could not move to {base}"
    return f"{home}'s worktree moved to the latest {base} ({tip[:7]})"


def plugin_records():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "plugins" / "installed_plugins.json"


def sync_plugin(home, path):
    """Claude Code keeps a plugin install record per project path, so each home's worktree has its own, and a plugin
    update in the main checkout never reaches it: the home's peers keep loading the old role rules. Point the home's
    record at the main checkout's version before its session starts. Only this plugin's record for this one path."""
    f = plugin_records()
    try:
        d = json.loads(f.read_text())
        name = json.loads((PLUGIN / ".claude-plugin" / "plugin.json").read_text())["name"]
    except (OSError, ValueError, KeyError):
        return None
    for key, entries in (d.get("plugins") or {}).items():
        if key.split("@")[0] != name or not isinstance(entries, list):
            continue
        at = lambda e, p: os.path.realpath(e.get("projectPath") or "/nonexistent") == os.path.realpath(p)
        main = next((e for e in entries if at(e, ROOT)), None)
        mine = next((e for e in entries if at(e, path)), None)
        if not (main and mine) or mine.get("installPath") == main.get("installPath") or \
                not Path(main.get("installPath") or "").is_dir():
            return None
        old = mine.get("version") or "?"
        for k in ("installPath", "version", "gitCommitSha"):
            if k in main:
                mine[k] = main[k]
        mine["lastUpdated"] = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())
        tmp = f.with_name(f.name + ".dev-team.tmp")
        tmp.write_text(json.dumps(d, indent=2) + "\n")
        os.replace(tmp, f)
        return f"{home}'s plugin moved from {old} to the main checkout's {main.get('version') or '?'}"
    return None


def close_session(home, h):
    """End the peer's session, close its terminal, and clean up after it; the worktree stays.
    None when done, else why not. The home's terminal is cleared once it is gone."""
    term = h.get("terminal")
    if not term:
        return None
    if not term_info(h):  # closed or orphaned already, maybe with its MCP servers still running
        h["terminal"] = None
        cleanup(home, h, term)
        return None
    b = busy(h)
    if b:
        return f"{home} is busy ('{b}' on its screen): wait for it to finish, or ask it to stop that first"
    if h.get("dispatch"):
        orca("orchestration", "worker-release", "--dispatch", h["dispatch"])
    # Orca can keep a closed terminal listed, disconnected, with no PTY; and a close sent as the session exits can
    # be dropped, so it is sent again while waiting.
    deadline, resend = time.time() + CLOSE_SEC, 0.0
    while True:
        t = term_info(h)
        if not t or (resend and t.get("connected") is False):
            break
        if time.time() >= deadline:
            return f"{home}'s terminal did not close in {CLOSE_SEC:g}s: look at it"
        if time.time() >= resend:
            orca("terminal", "close", "--terminal", term, *on(h))
            resend = time.time() + CLOSE_RESEND_SEC
        time.sleep(0.5)
    h["terminal"] = None
    cleanup(home, h, term)
    return None


def orca_version(env=None):
    """The running Orca's version (a shell keeps the hook port of the Orca it started under)."""
    return find(orca("status", *(["--environment", env] if env else []))[0], "appVersion") or ""


def failure(w):
    d = w.get("dispatch") or {}
    lf = d.get("lastFailure")
    try:
        lf = json.loads(lf) if isinstance(lf, str) else lf
    except ValueError:
        pass
    if isinstance(lf, dict):
        text = lf.get("subject") or lf.get("message") or lf.get("code") or ""
        return text + (f": {lf['body'][:300]}" if lf.get("body") else "") or "no reason given"
    return str(lf or d.get("terminationReason") or "no reason given")


def new_worktree(sel, name, base):
    if sel not in ("new-child", "new-top-level"):
        return sel
    if not name:
        die("a new worktree needs --name")
    lineage = ["--parent-worktree", "current"] if sel == "new-child" else ["--no-parent"]
    d, raw = orca("worktree", "create", "--name", name, *(["--base-branch", base] if base else []), *lineage,
                  timeout=900)
    path = find(d, "path") or die("worktree create failed:\n" + raw[:800], 1)
    return "path:" + path


def pick_name(reg):
    taken = {h.get("name") for h in reg["homes"].values()}
    return random.choice([n for n in NAMES if n not in taken] or NAMES)


def label(home, h):
    return f"{h.get('name') or home} · {ROLE_WORD.get(h['role'], h['role'])}"


def label_worktree(home, h):
    """A home's own worktree (named after it, as Team setup makes them) shows the home's name and role in Orca."""
    path = h.get("worktree")
    if h.get("env") or not path or Path(path).name != home or h.get("labelled") == path:
        return
    d, _ = orca("worktree", "set", "--worktree", "path:" + path, "--display-name", label(home, h))
    if d.get("ok"):
        h["labelled"] = path


def team_homes():
    """The homes the dev-team section's Team setup § Homes rule names, in order; `dt-dev-1` to `dt-dev-4` expands."""
    m = re.search(r"^- \*\*Homes\.\*\*(.*)$", project_text(), re.M)
    line = re.sub(r"`(dt-[\w-]*?)(\d+)` to `\1(\d+)`",
                  lambda x: ", ".join(f"`{x.group(1)}{i}`" for i in range(int(x.group(2)), int(x.group(3)) + 1)),
                  m.group(1) if m else "")
    return list(dict.fromkeys(re.findall(r"`(dt-[\w-]+)`", line)))


def home_role(home):
    return next((r for prefix, r in HOME_ROLE if home == prefix or home.startswith(prefix + "-")), None)


def home_or_die(reg, home):
    h = reg["homes"].get(home)
    if h and h.get("asleep"):
        die(f"{home} is asleep: nothing would read the message. Put it in the home's next dispatch spec.")
    if not h or not (h.get("terminal") or (h.get("env") and h.get("dispatch"))):
        die(f"no live peer in home {home}; see `peer list`")
    return h


def opts(argv, flags, switches=()):
    """Split argv into positionals, --flag values, and --switches."""
    pos, val, on = [], {}, set()
    it = iter(argv)
    for a in it:
        if a in switches:
            on.add(a)
        elif a in flags:
            val[a] = next(it, None) or die(f"{a} needs a value")
        else:
            pos.append(a)
    return pos, val, on


# --- working hours (workflow/handoffs.md § Working hours) -----------------------------------------------------------

def _hours():
    import importlib.util
    from importlib.machinery import SourceFileLoader
    loader = SourceFileLoader("dt_hours", str(PLUGIN / "bin" / "hours"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("dt_hours", loader))
    loader.exec_module(mod)
    return mod


HOURS = _hours()


def hours_now():
    """(open, the Hours value, when it flips, as text); a line that doesn't parse counts as open, as in bin/hours."""
    from datetime import datetime
    try:
        is_open, value, flip = HOURS.state(str(ROOT))
    except ValueError:
        return True, "", ""
    return is_open, value, HOURS.when(flip, datetime.now()) if flip else ""


WRAP_SUBJECT = "Working hours are over"
WRAP_BODY = ("Working hours are over. Finish at your next clean point: commit and push what is done, write a hand-over "
             "note (workflow/handoffs.md § Assume mistakes), then send worker_done. Start nothing new.")


def cmd_wrap_up(argv):
    reg = load()
    homes = [home for home, h in sorted(reg["homes"].items())
             if h.get("dispatch") and not h.get("asleep") and working(h)]
    if not homes:
        return print("no peer is working")
    for home in homes:
        try:
            cmd_tell([home, WRAP_SUBJECT, WRAP_BODY])
        except SystemExit as e:
            if e.code not in (None, 0):
                print(f"{home}: not told ({e.code if isinstance(e.code, str) else 'see above'})")
    print("As each one reports, `peer sleep --idle`; start nothing new until working hours start again.")


# --- dispatch -------------------------------------------------------------------------------------------------------

def cmd_dispatch(argv):
    pos, val, on_ = opts(argv, ("--worktree", "--name", "--base-branch", "--title", "--on", "--repo", "--model",
                                "--effort"), ("--keep", "--restart", "--owner"))
    if len(pos) != 3 or {"--keep", "--restart"} <= on_:
        die(__doc__)
    is_open, value, flip = hours_now()
    if not is_open and "--owner" not in on_:
        die(f"outside working hours ({value}; open again {flip}): the team starts nothing on its own. If the Owner "
            "asked for this task, add --owner.")
    home, role, spec = pos
    if os.path.isfile(spec):
        spec = Path(spec).read_text()
    once = val.get("--model", ""), (val.get("--effort") or "").lower()
    if once[1] and once[1] not in EFFORTS:
        die(f"--effort is one of {', '.join(EFFORTS)}")
    reg = load()
    run = bind(reg)
    h = reg["homes"].get(home)
    if h and h["role"] != role:
        die(f"{home} is a {h['role']} home, not {role}")
    env = val.get("--on") or (h or {}).get("env")
    if h and val.get("--on") and val["--on"] != h.get("env"):
        die(f"{home} runs on {h.get('env') or 'this machine'}: use another home for {val['--on']}")
    title = val.get("--title") or spec.strip().splitlines()[0][:80]
    if h and working(h):
        die(f"{home} is still working on '{h['title']}' ({h['dispatch']}). Wait for its report; to cancel, follow "
            "Orca's recovery guide (worker-stop, then worker-abandon if it reports stop_unknown).")
    wt = val.get("--worktree")
    name = (h or {}).get("name") or pick_name(reg)
    if h and h.get("worktree") and not env and wt == "new-top-level" and val.get("--name") == home:
        wt = None  # `peer team --create` made it already: reuse it
    model, effort, flags = (h or {}).get("model"), (h or {}).get("effort"), []
    version, sel = (h or {}).get("orca"), (h or {}).get("worktree_sel")
    if "--keep" in on_:
        if any(once):
            die("a model or effort for one task needs a fresh session: drop --keep")
        if env:
            die(f"{home} runs on {env}: a remote peer takes each task fresh, so drop --keep")
        if not h or h.get("asleep") or not term_info(h) or wt:
            die(f"--keep continues {home}'s live session in its own worktree, and it has none: dispatch it fresh")
        now = orca_version()
        if version and now and version != now:
            die(f"{home}'s shell started under Orca {version}, and Orca is now {now}: its hook port is stale, so the "
                "dispatch would time out at agent readiness. Dispatch it fresh, without --keep.")
        mode, term, path = "keep", h["terminal"], h["worktree"]
        place = ["--terminal", term, "--worktree", "path:" + path]
    else:
        model, effort, flags, notes = launch_plan(role, *once)
        mode = "new" if not h else "wake" if h.get("asleep") or not h.get("terminal") else "fresh"
        if env:
            # Orca starts a remote peer itself (worker-start --on): it takes the model and effort, nothing more.
            target = wt or sel or die(f"{home} is a new home on {env}: pass --worktree — an exact remote selector "
                                      "(id:<repo-id>::<path>), or new-top-level with --repo and --name")
            if target in ("current", "new-child"):
                die("on a remote server, current and new-child are ambiguous: pass an exact selector "
                    "(id:<repo-id>::<path>), or new-top-level with --repo and --name")
            if target == "new-top-level" and not (val.get("--repo") and val.get("--name")):
                die("new-top-level on a remote server needs --repo and --name")
            if len(flags) > 4:
                notes.append(f"on {env} a launch takes only the model and effort: no fallback model, advisor, or "
                             "DEV_TEAM_CLAUDE flags")
        else:
            target = wt or (h and "path:" + h["worktree"]) or die(f"{home} is a new home: pass --worktree")
        why = close_session(home, h) if h else None
        if why:
            save(reg)
            die(why)
        if not env and h and h.get("worktree") and wt in (None, "path:" + h["worktree"]):
            if role in BASE_ROLES:
                notes.append(refresh_worktree(home, h["worktree"]))
            notes.append(sync_plugin(home, h["worktree"]))
        for n in filter(None, notes):
            print(n)
        if env:
            term, path, version = None, None, orca_version(env)
            place = ["--on", env, "--agent", "claude", "--model", model, "--effort", effort, "--worktree", target]
            if target == "new-top-level":
                place += ["--repo", val["--repo"], "--name", val["--name"]] + \
                         (["--base-branch", val["--base-branch"]] if val.get("--base-branch") else [])
        else:
            # A fresh session per task, launched with the pinned settings: a new terminal, so new MCP servers,
            # settings, and plugin updates load too, and a shell from before an Orca update is never reused.
            cmd = shlex.join(shlex.split(os.environ.get("DEV_TEAM_CLAUDE", "claude")) + flags)
            d, raw = orca("terminal", "create", "--worktree",
                          new_worktree(target, val.get("--name"), val.get("--base-branch")),
                          "--title", label(home, {"name": name, "role": role}), "--command", cmd)
            term = find(d, "handle") or die("terminal create failed:\n" + raw[:800], 1)
            orca("terminal", "wait", "--terminal", term, "--for", "tui-idle", "--timeout-ms", "90000")
            path = term_info({"terminal": term}).get("worktreePath") or \
                die(f"cannot tell the worktree of the new terminal {term}", 1)
            version = orca_version()
            place = ["--terminal", term, "--worktree", "path:" + path]
        # Recorded before worker-start, so a failed start still leaves the new session closable.
        reg["homes"][home] = dict(h or {}, role=role, terminal=term, worktree=path or (h or {}).get("worktree"),
                                  dispatch=None, title=title, since=time.strftime("%Y-%m-%d %H:%M"), model=model,
                                  effort=effort, asleep=False, env=env, orca=version, once=any(once), name=name)
        label_worktree(home, reg["homes"][home])
        save(reg)

    body = ROLE_LINE.format(role=role, home=home) + f" Your name on the team is {name}."
    if "--settings" in flags and not env:
        body += ADVISOR_LINE
    d, raw = orca("orchestration", "worker-start", "--run", run, "--task-title", title, "--spec", body + "\n\n" + spec,
                  *place, timeout=900)
    dispatch, task = find(d, "dispatchId"), find(d, "taskId")
    # worker-start can exit non-zero after the dispatch went through, so judge by the receipt, never relaunch blindly.
    if not d.get("ok") or not dispatch:
        hint = ""
        if mode == "keep" and find(d, "failedStage") == "agent_readiness":
            hint = f"\n{home}'s shell may predate the running Orca (a stale hook port): dispatch it fresh, without --keep."
        die("worker-start did not report ready. Check `orca orchestration task-list` before retrying." + hint +
            "\n" + raw[:800], 1)
    # Ready can still turn into failed a moment later — for one, when the terminal already holds a dispatch.
    time.sleep(RECHECK_SEC)
    w = worker(dispatch)
    if env:
        term = find(w, "agentTerminalHandle") or find(d, "agentTerminalHandle")
        wid = find(w, "worktreeId") or find(d, "worktreeId") or ""
        path = wid.split("::", 1)[-1] if "::" in wid else path or target
        sel = "id:" + wid if "::" in wid else (target if target != "new-top-level" else sel)
    reg["homes"][home] = {
        "role": role, "terminal": term, "worktree": path, "dispatch": dispatch, "task": task, "title": title,
        "since": time.strftime("%Y-%m-%d %H:%M"), "model": model, "effort": effort, "asleep": False,
        "env": env, "worktree_sel": sel if env else None, "orca": version,
        "once": any(once) if mode != "keep" else (h or {}).get("once", False),
        "name": name, "labelled": reg["homes"].get(home, {}).get("labelled"),
    }
    save(reg)
    if (w.get("dispatch") or {}).get("status") == "failed" or (w.get("worker") or {}).get("state") == "failed":
        die(f"{home}: worker-start reported ready, but the dispatch failed {RECHECK_SEC:g}s later: {failure(w)}. "
            "A terminal that already holds a dispatch fails this way: dispatch it fresh"
            + (", without --keep." if mode == "keep" else "."), 1)
    where = f" on {env}" if env else ""
    print(f"dispatched {home}, {name} ({mode}{where}, {model}/{effort}): {title} — {task} {dispatch}")


# --- switch and sleep -----------------------------------------------------------------------------------------------

def cmd_switch(argv):
    reg = load()
    for home in argv or sorted(reg["homes"]):
        h = reg["homes"].get(home)
        if not h or not h.get("terminal") or h.get("asleep") or session_alive(h) is False:
            print(f"{home}: no live session; its next dispatch launches with the current settings")
            continue
        if h.get("once") and not argv:
            print(f"{home}: on a model chosen for this one task; its next dispatch returns to the team settings")
            continue
        model, effort, _, notes = launch_plan(h["role"])
        if (h.get("model"), h.get("effort")) == (model, effort):
            print(f"{home}: already on {model}/{effort}")
            continue
        for n in notes:
            print(f"{home}: {n}")
        send(h, f"/model {model}")
        send(h, f"/effort {effort}")
        time.sleep(STEP_SEC)
        shown = "\n".join(live_screen(h)[-20:])
        if re.search(r"set model to", shown, re.I) and re.search(r"effort", shown, re.I):
            h["model"], h["effort"], h["once"] = model, effort, False
            print(f"{home}: switched to {model}/{effort}")
        else:
            print(f"{home}: sent /model {model} and /effort {effort}, not confirmed on its screen "
                  "(it may be mid-turn): look at it, then run `peer switch` again")
    save(reg)


def cmd_sleep(argv):
    pos, _, on = opts(argv, (), ("--idle",))
    reg = load()
    if not pos and "--idle" not in on:
        die(__doc__)
    for home in pos or sorted(reg["homes"]):
        h = reg["homes"].get(home)
        if not h or not h.get("terminal") or h.get("asleep"):
            if pos:
                print(f"{home}: already asleep, or no terminal")
            continue
        if working(h):
            if pos:
                print(f"{home}: still working, left awake")
            continue
        why = close_session(home, h)
        if why:
            print(why)
            continue
        h.update(asleep=True, terminal=None)
        print(f"{home}: asleep")
    save(reg)


def cmd_adopt(argv):
    """A terminal started outside peer — a peer launched by hand, or a bare shell left after its session ended —
    becomes a home, so the next dispatch closes it and launches fresh."""
    pos, val, _ = opts(argv, ("--on",))
    if len(pos) != 3:
        die(__doc__)
    home, role, term = pos
    reg = load()
    h = reg["homes"].get(home) or {}
    if h.get("role", role) != role:
        die(f"{home} is a {h['role']} home, not {role}")
    if h.get("terminal") and h["terminal"] != term and term_info(h):
        die(f"{home} already has a live terminal, {h['terminal']}: sleep it first")
    new = {"terminal": term, "env": val.get("--on")}
    info = term_info(new) or die(f"no open terminal {term}" + (f" on {new['env']}" if new["env"] else ""))
    reg["homes"][home] = dict(h, role=role, terminal=term, env=new["env"], dispatch=None, asleep=False,
                              worktree=info.get("worktreePath") or h.get("worktree"), title=h.get("title") or "(adopted)",
                              since=h.get("since") or time.strftime("%Y-%m-%d %H:%M"))
    save(reg)
    print(f"{home}: adopted {term}; its next dispatch closes that terminal and launches a fresh session")


# --- tell -----------------------------------------------------------------------------------------------------------

def nudge(h, subject):
    """Type a one-line nudge into the peer's terminal: an idle peer never reads its mailbox on its own."""
    term = h["terminal"]
    text = f"From coordinator: {subject} — check your orchestration messages, and --ack each batch until check is empty."
    send_ = ["orca", "terminal", "send", "--terminal", term, "--text", text, "--enter", *on(h)]
    out = subprocess.run(send_, capture_output=True, text=True, timeout=120)
    req = re.search(r"--retry-request\s+([0-9a-f-]+)", out.stdout + out.stderr)
    for _ in range(3):
        if not req:
            return print("nudge delivered")
        out = subprocess.run(send_ + ["--retry-request", req.group(1), "--wait-submit", "20"],
                             capture_output=True, text=True, timeout=120)
        if "no turn start was observed" not in out.stdout + out.stderr:
            return print("nudge delivered")
    # A peer mid-turn queues the input: trust its screen, not the warning.
    shown = subprocess.run(["orca", "terminal", "read", "--terminal", term, "--screen", *on(h)],
                           capture_output=True, text=True, timeout=120).stdout
    if subject in shown:
        return print("nudge queued: the peer is mid-turn and reads it next")
    die(f"NUDGE NOT CONFIRMED for {term}: look at the peer's terminal")


NUDGES = STATE / "nudges-unconfirmed.txt"


def cmd_nudge(argv):
    """peer tell's background nudge. One that is never confirmed is left for peer watch to report as NUDGE."""
    home, subject = argv[0], argv[1]
    h = load()["homes"].get(home) or {}
    if not h.get("terminal"):
        return
    try:
        nudge(h, subject)
    except SystemExit as e:
        if e.code and not busy(h):  # mid-turn, it reads the queued nudge (or has read the mail) at its next turn
            with NUDGES.open("a") as f:
                f.write(f"{home}\t{subject}\n")


def unconfirmed_nudges():
    """Nudges the background nudger gave up on, once each."""
    try:
        taken = NUDGES.with_name(NUDGES.name + f".{os.getpid()}")
        os.replace(NUDGES, taken)
    except OSError:
        return []
    lines = [line.split("\t", 1) for line in taken.read_text().splitlines() if "\t" in line]
    taken.unlink(missing_ok=True)
    return [f"NUDGE | {home} | not confirmed for '{subject}': look at its terminal" for home, subject in lines]


def cmd_tell(argv):
    pos, val, on_ = opts(argv, ("--reply",), ("--wait",))
    if len(pos) != 3:
        die(__doc__)
    home, subject, body = pos
    reg = load()
    h = home_or_die(reg, home)
    run = bind(reg)
    if "--reply" in val:
        d, raw = orca("orchestration", "reply", "--run", run, "--id", val["--reply"], "--body", body)
    else:
        if settled(worker(h["dispatch"])):
            die(f"{home} has finished its dispatch and will not act on mail: "
                "send follow-up work with `peer dispatch --keep`")
        d, raw = orca("orchestration", "send", "--run", run, "--to", "dispatch:" + h["dispatch"],
                      "--subject", subject, "--body", body)
    if not d.get("ok"):
        die("message not sent:\n" + raw[:800], 1)
    if not h.get("terminal"):
        return print(f"sent; {home} on {h.get('env')} has no terminal to nudge, so it reads the message at its next turn")
    if "--wait" in on_:
        return nudge(h, subject)
    # The nudge can take a minute against a busy peer: it runs on its own, so the coordinator's turn stays free.
    STATE.mkdir(parents=True, exist_ok=True)
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "nudge", home, subject], cwd=str(ROOT),
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    print(f"sent; nudging {home} in the background (peer watch reports a nudge that doesn't land)")


# --- pending and watch ----------------------------------------------------------------------------------------------

def names(reg):
    return {h["terminal"]: home for home, h in reg["homes"].items() if h.get("terminal")}


def pending_batch(run):
    """The oldest unacknowledged batch, after acknowledging any batch that holds only heartbeats."""
    while True:
        r = orca("orchestration", "check", "--run", run)[0].get("result") or {}
        delivery, msgs = r.get("deliveryId"), r.get("messages") or []
        if not delivery or any(m.get("type") != "heartbeat" for m in msgs):
            return delivery, msgs
        orca("orchestration", "check", "--run", run, "--ack", delivery)


SEEN_FILE = STATE / "seen-messages"


def seen_ids():
    return set(SEEN_FILE.read_text().split()) if SEEN_FILE.exists() else set()


def mark_seen(msgs):
    """Record the messages shown to the coordinator, so `peer ack` can tell which joined a batch after it was read."""
    ids = [m["id"] for m in msgs if m.get("id")]
    if not ids:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    with open(SEEN_FILE, "a") as f:
        f.write("\n".join(ids) + "\n")
    if SEEN_FILE.stat().st_size > 64_000:  # keep the newest half
        keep = SEEN_FILE.read_text().split()[-2000:]
        SEEN_FILE.write_text("\n".join(keep) + "\n")


def describe(who, m, full=False):
    body = m.get("body") or ""
    cut = not full and len(body) > 700
    line = f"{m.get('type')} | {who.get(m.get('from_handle'), m.get('from_handle') or '?')} | id {m.get('id')} | " \
           f"{m.get('subject')} | {body if not cut else body[:700]}"
    if not cut:
        return line
    friction = re.findall(r"^Friction:.*$", body, re.M)
    rest = f" … {friction[-1]}" if friction and friction[-1] not in body[:700] else ""
    return line + rest + f" [cut: {len(body) - 700} more characters; `peer pending --full` shows them]"


def show_batch(reg, run, delivery, msgs, full=False):
    who = names(reg)
    shown = [m for m in msgs if m.get("type") != "heartbeat"]
    for m in shown:
        print(describe(who, m, full))
    mark_seen(shown)
    print(f"Handle every message, then acknowledge: {PLUGIN}/bin/peer ack {delivery}")
    # A PR link in a peer's report records that home as the PR's owner, for CI and conflict alerts.
    found = [(who[m["from_handle"]], repo, n) for m in msgs if who.get(m.get("from_handle"))
             for repo, n in PR_URL.findall(f"{m.get('subject')} {m.get('body')}")]
    if found:
        r = load()
        default_repo(r)
        for home, repo, n in found:
            r.setdefault("prs", {}).setdefault(f"{repo}#{n}", {})["home"] = home
        save(r)


# --- PRs: who owns which, and what changed on them ------------------------------------------------------------------

def gh(*a):
    try:
        p = subprocess.run(["gh", *a], capture_output=True, text=True, timeout=60)
        return p.stdout if p.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def default_repo(reg):
    if not reg.get("repo"):
        reg["repo"] = gh("repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner").strip()
    return reg["repo"]


def pr_key(ref, repo):
    m = PR_URL.search(ref)
    if m:
        return f"{m.group(1)}#{m.group(2)}"
    n = ref.lstrip("#")
    return f"{repo}#{n}" if n.isdigit() and repo else die(f"not a PR number or URL: {ref}")


def pr_label(key, reg):
    repo, n = key.rsplit("#", 1)
    return f"#{n}" if repo == reg.get("repo") else f"{repo.split('/')[-1]}#{n}"


def pr_status(key):
    repo, n = key.rsplit("#", 1)
    try:
        p = json.loads(gh("pr", "view", n, "-R", repo, "--json", "state,isDraft,mergeable,statusCheckRollup") or "{}")
    except ValueError:
        p = {}
    if not p.get("state"):
        return None
    failed = sorted({c.get("name") or c.get("context") or "a check" for c in p.get("statusCheckRollup") or []
                     if (c.get("conclusion") or c.get("state") or "").upper() in FAIL})
    return {"state": p["state"], "draft": bool(p.get("isDraft")), "failed": failed,
            "conflict": p.get("mergeable") == "CONFLICTING"}


def route(home, h):
    if not h:
        return "route it to whoever owns it"
    return f"route it to {home}" + (" (`peer dispatch --keep`)" if h.get("terminal") and not h.get("asleep") else "")


def pr_events(board):
    """Changes on the team's PRs since the last look: merged, closed, draft or ready (with the Owner board on), and,
    while the owner is not working, a newly failing check or a merge conflict."""
    reg, events = load(), []
    for key, rec in reg.get("prs", {}).items():
        if rec.get("state") in ("MERGED", "CLOSED"):
            continue
        st = pr_status(key)
        if not st:
            continue
        home = rec.get("home") or "?"
        h, label = reg["homes"].get(home), pr_label(key, reg)
        seen = "state" in rec
        if board and seen and st["state"] != "OPEN":
            events.append(f"PR | {label} | {home} | {st['state'].lower()}: update its status row and the board")
        elif board and seen and st["draft"] != rec.get("draft"):
            events.append(f"PR | {label} | {home} | {'back to draft' if st['draft'] else 'marked ready'}: "
                          "update the board")
        rec.update(state=st["state"], draft=st["draft"])
        free = not (h and working(h))
        new = [c for c in st["failed"] if c not in rec.get("failed", [])]
        if st["state"] == "OPEN" and new and free:
            events.append(f"CI | {label} | {home} | failed: {', '.join(new)[:160]}: {route(home, h)}")
        if free or not st["failed"]:
            rec["failed"] = st["failed"]
        if st["state"] == "OPEN" and st["conflict"] and not rec.get("conflict") and free:
            events.append(f"CONFLICT | {label} | {home} | merge conflict with its base: {route(home, h)}")
        if free or not st["conflict"]:
            rec["conflict"] = st["conflict"]
    if reg.get("prs"):
        r = load()
        r["prs"] = {k: dict(r.get("prs", {}).get(k, {}), **v) for k, v in reg["prs"].items()}
        save(r)
    return events


def cmd_pr(argv):
    pos, val, on_ = opts(argv, ("--repo",), ("--drop",))
    reg = load()
    repo = val.get("--repo") or default_repo(reg)
    prs = reg.setdefault("prs", {})
    if "--drop" in on_:
        for ref in pos:
            prs.pop(pr_key(ref, repo), None)
        save(reg)
        return print(f"dropped {len(pos)} PR(s)")
    if len(pos) < 2 or pos[0] not in reg["homes"]:
        die(__doc__ if len(pos) < 2 else f"no home {pos[0]}; see `peer list`")
    for ref in pos[1:]:
        prs.setdefault(pr_key(ref, repo), {})["home"] = pos[0]
    save(reg)
    print(f"{pos[0]} owns " + ", ".join(pr_label(pr_key(ref, repo), reg) for ref in pos[1:]))


def cmd_prs(argv):
    reg = load()
    repo, prs = default_repo(reg), reg.get("prs", {})
    if "--sweep" not in argv:
        for key, rec in sorted(prs.items()):
            print(f"{pr_label(key, reg):14} {rec.get('home', '?'):14} {(rec.get('state') or 'not checked yet').lower()}"
                  + (" draft" if rec.get("draft") else ""))
        return print("no PRs recorded") if not prs else None
    keys = {k for k, r in prs.items() if r.get("state") not in ("MERGED", "CLOSED")}
    for n in gh("pr", "list", "-R", repo, "--author", "@me", "--state", "open", "--json", "number",
                "-q", ".[].number").split() if repo else []:
        keys.add(f"{repo}#{n}")
    bad = []
    for key in sorted(keys):
        st = pr_status(key)
        if st and st["state"] == "OPEN" and (st["failed"] or st["conflict"]):
            home = prs.get(key, {}).get("home") or "?"
            what = ([f"failing: {', '.join(st['failed'])[:160]}"] if st["failed"] else []) + \
                   (["merge conflict"] if st["conflict"] else [])
            bad.append(f"{pr_label(key, reg):14} {home:14} {'; '.join(what)}: {route(home, reg['homes'].get(home))}")
    save(reg)
    print("\n".join(bad) if bad else f"no failing checks or conflicts on {len(keys)} open PR(s)")
    sys.exit(1 if bad else 0)


# --- the Owner board: stamp, guard, drift (workflow/board.md) -------------------------------------------------------

def ws_root():
    m = re.search(r"\*\*Workspace:\*\*\s*`([^`]*)`", project_text())
    return ROOT / ((m.group(1) if m else "") or "docs").rstrip("/")


def board_on():
    return "**Owner board:**" in project_text()


def status_hash():
    h = hashlib.sha256()
    for name in ("status.md", "status-done.md"):
        f = ws_root() / name
        h.update((f.read_bytes() if f.exists() else b"") + b"\0")
    return h.hexdigest()


def stamp():
    try:
        return json.loads(BOARD.read_text())
    except (OSError, ValueError):
        return {}


def board_guard():
    """The line the coordinator sees while <ws>/status.md has changed since the last board write; else None."""
    if not board_on():
        return None
    st = stamp()
    if st.get("root") and st["root"] != str(ROOT):
        return None  # the board is kept from another checkout
    if st.get("hash") == status_hash():
        return None
    why = "status changed since the last board write" if st else "no board write recorded yet"
    return f"{why}: update the board, then `{PLUGIN}/bin/peer board-stamp`"


def cmd_board_stamp(argv):
    _, val, _ = opts(argv, ("--rows",))
    st = stamp()
    st.update(hash=status_hash(), time=time.strftime("%Y-%m-%dT%H:%M:%S%z"), root=str(ROOT))
    if val.get("--rows"):
        st["rows"] = str(Path(val["--rows"]).resolve())
        (STATE / "board-drift-seen.txt").unlink(missing_ok=True)  # a new snapshot: drift is reported afresh
    STATE.mkdir(parents=True, exist_ok=True)
    BOARD.write_text(json.dumps(st, indent=2) + "\n")
    print(f"board stamped {st['time']}" + (f"; rows in {st['rows']}" if st.get("rows") else ""))


def features_root():
    m = re.search(r"\*\*Workspace:\*\*.*?\bfeatures\s+`([^`]*)`", project_text())
    return ROOT / m.group(1).rstrip("/") if m else ws_root() / "features"


def status_report():
    """After a watch: status.md rows whose task count fell behind the task index, or whose cells grew into a log.
    Each line is reported once until it changes."""
    f = ws_root() / "status.md"
    if not f.exists():
        return
    try:
        p = subprocess.run([str(PLUGIN / "bin" / "board-drift"), "--status", str(f), "--features", str(features_root()),
                            "--no-prs"], capture_output=True, text=True, timeout=60, cwd=str(ROOT))
    except (OSError, subprocess.TimeoutExpired):
        return
    if p.returncode != 1:
        return
    seen_file = STATE / "status-drift-seen.txt"
    seen = set(seen_file.read_text().splitlines()) if seen_file.exists() else set()
    new = [line for line in p.stdout.splitlines() if line.strip() and line not in seen]
    with seen_file.open("a") as out:
        out.writelines(line + "\n" for line in new)
    if new:
        print("\n".join(f"STATUS | {line}" for line in new))


def board_report():
    """After a watch: the board guard line, and board-drift on the rows the coordinator last listed."""
    if not board_on():
        return
    lines, g, rows = [], board_guard(), stamp().get("rows")
    if g:
        lines.append(f"BOARD | {g}")
    if rows and Path(rows).is_dir():
        try:
            p = subprocess.run([str(PLUGIN / "bin" / "board-drift"), rows], capture_output=True, text=True, timeout=600)
            if p.returncode == 1:
                seen_file = STATE / "board-drift-seen.txt"
                seen = set(seen_file.read_text().splitlines()) if seen_file.exists() else set()
                new = [line for line in p.stdout.splitlines() if line.strip() and line not in seen]
                with seen_file.open("a") as f:  # reported once: the saved rows don't change when the board does
                    f.writelines(line + "\n" for line in new)
                lines += [f"BOARD | {line}" for line in new]
        except (OSError, subprocess.TimeoutExpired):
            pass
    if lines:
        print("\n".join(lines))


def cmd_pending(argv):
    reg = load()
    run = bind(reg)
    delivery, msgs = pending_batch(run)
    if not delivery:
        return print("no unhandled reports")
    show_batch(reg, run, delivery, msgs, full="--full" in argv)
    sys.exit(1)


def cmd_ack(argv):
    """Acknowledge a batch only once every message in it has been shown: messages join a batch until it is
    acknowledged, and an ack covers them all, read or not."""
    if len(argv) != 1:
        die("usage: peer ack <delivery>")
    reg = load()
    run = bind(reg)
    delivery, msgs = pending_batch(run)
    if not delivery:
        return print("no unhandled reports")
    if delivery != argv[0]:
        print(f"{argv[0]} is not the open batch: it was acknowledged already, or the id is wrong. The open one:")
        show_batch(reg, run, delivery, msgs)
        sys.exit(1)
    seen = seen_ids()
    new = [m for m in msgs if m.get("type") != "heartbeat" and m.get("id") not in seen]
    if new:
        print(f"Not acknowledged: {len(new)} message(s) joined this batch after you read it. Handle them too, then "
              f"`peer ack {delivery}` again:")
        who = names(reg)
        for m in new:
            print(describe(who, m))
        mark_seen(new)
        sys.exit(1)
    d, raw = orca("orchestration", "check", "--run", run, "--ack", delivery)
    if not d.get("ok", True):
        die("ack failed:\n" + raw[:800], 1)
    print(f"acknowledged {delivery}")
    delivery, msgs = pending_batch(run)
    if delivery:
        print("The next batch:")
        show_batch(reg, run, delivery, msgs)
        sys.exit(1)


def transcript(reg, home, h):
    """The peer's current session transcript: the newest one in its worktree that carries its home marker."""
    d = CLAUDE_DIR / "projects" / re.sub(r"[^A-Za-z0-9]", "-", h.get("worktree") or "")
    files = sorted(d.glob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True)[:6]
    marker = f"[dev-team home {home}]"
    for f in files:
        if marker in f.read_text(errors="ignore"):
            return f
    alone = sum(x.get("worktree") == h.get("worktree") for x in reg["homes"].values()) == 1
    return files[0] if files and alone else None


def context_k(f):
    last = None
    for line in f.open(errors="ignore"):
        if '"usage"' in line:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("type") == "assistant":
                last = (e.get("message") or {}).get("usage") or last
    keys = ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
    return sum(last.get(k, 0) for k in keys) // 1000 if last else 0


def cmd_sizes(argv):
    reg, limit = load(), size_limit()
    for home, h in sorted(reg["homes"].items()):
        if h.get("env"):
            print(f"{home:14} {h['role']:19} on {h['env']}: no local transcript")
            continue
        f = transcript(reg, home, h)
        k = context_k(f) if f else 0
        flag = "  OVER" if k > limit else ""
        print(f"{home:14} {h['role']:19} ~{k}k / {limit}k{flag}" if f else f"{home:14} {h['role']:19} no session found")


def record_limit(text):
    """Note the model a usage-limit screen names, so launches use the fallback until it resets."""
    m = LIMIT.search(text)
    family = ((m.group(1) or "").split() or [""])[0].lower() if m else ""
    if family:
        lim = limits()
        lim[family] = {"text": m.group(0).strip(), "seen": date.today().isoformat()}
        LIMITS.write_text(json.dumps(lim, indent=2) + "\n")
    return family


def watch_screens(active, last, since, now):
    """STUCK or LIMIT for a peer stopped on an error screen, STALL for one whose screen has not changed; else None."""
    for home, h in active.items():
        lines = live_screen(h) if h.get("terminal") else []
        if not lines:
            continue
        sig = "\n".join(lines)
        if sig != last.get(home):
            last[home], since[home] = sig, now
        quiet, tail = now - since[home], "\n".join(lines[-15:])
        if quiet >= STUCK_MIN * 60 and "esc to interrupt" not in tail:
            m = LIMIT.search(tail)
            if m:
                family = record_limit(tail)
                fix = f"`peer switch {home}` moves it to the fallback model" if family and setting("Fallback model") \
                    else "it waits for the reset, or a model you switch it to"
                return f"LIMIT | {home} | {m.group(0).strip()}: {fix}. Look at its screen first."
            m = STUCK.search(tail)
            if m:
                return f"STUCK | {home} | {m.group(0).strip()[:200]}: it stopped on an error. Tell it to continue: " \
                       f"peer tell {home} \"Continue\" \"The last call failed; carry on with your task.\""
        if quiet >= STALL_MIN * 60:
            return f"STALL | {home} | screen unchanged for {STALL_MIN:g} min on '{h['title']}': look at it"
    return None


def cmd_watch(argv):
    STATE.mkdir(parents=True, exist_ok=True)
    WATCH_PID.write_text(str(os.getpid()))
    try:
        watch(float(argv[0]) if argv else 15)
    finally:
        WATCH_PID.unlink(missing_ok=True)
    status_report()
    board_report()


def hold_lock():
    """A running watch means a live interactive coordinator: hold the coordinator lock as owner and keep it fresh, so a
    check-in never routes beside it (an unrefreshed lock expires after DEV_TEAM_LOCK_TTL_MIN). A check-in's lock is
    left alone."""
    ttl = float(os.environ.get("DEV_TEAM_LOCK_TTL_MIN", "30")) * 60
    try:
        holder, fresh = LOCK.read_text().strip(), time.time() - LOCK.stat().st_mtime < ttl
    except OSError:
        holder, fresh = "", False
    if fresh and holder not in ("", "owner"):
        return
    STATE.mkdir(parents=True, exist_ok=True)
    LOCK.write_text("owner\n")


def watch(minutes):
    reg = load()
    run = bind(reg)
    end, limit, board = time.time() + minutes * 60, size_limit(), board_on()
    flagged_file = STATE / "size-flagged.txt"
    last, since, active = {}, {}, {}
    next_active = next_size = next_pr = 0
    was_open = hours_now()[0]
    while time.time() < end or not was_open:  # while closed, the time limit never wakes the coordinator
        hold_lock()
        is_open, value, flip = hours_now()
        if is_open != was_open:
            return print(hours_event(is_open, value, flip, active))
        delivery, msgs = pending_batch(run)
        if delivery:
            return show_batch(reg, run, delivery, msgs)
        missed = unconfirmed_nudges()
        if missed:
            return print("\n".join(missed))
        now = time.time()
        if now >= next_active:
            reg = load()
            active = {home: h for home, h in reg["homes"].items() if h.get("dispatch") and not h.get("asleep") and working(h)}
            next_active = now + 120
        if now >= next_size:
            next_size = now + 15 * 60
            flagged = set(flagged_file.read_text().split()) if flagged_file.exists() else set()
            for home, h in active.items():
                f = None if h.get("env") else transcript(reg, home, h)
                if f and f.name not in flagged and context_k(f) > limit:
                    with flagged_file.open("a") as out:
                        out.write(f.name + "\n")
                    return print(f"SIZE | {home} | ~{context_k(f)}k, over the {limit}k limit: tell it to finish "
                                 "at its next clean point with a hand-over note")
        found = watch_screens(active, last, since, now)
        if found:
            return print(found)
        if now >= next_pr and is_open:  # PR alerts wait for working hours
            next_pr = now + PR_POLL_MIN * 60
            events = pr_events(board)
            if events:
                return print("\n".join(events))
        time.sleep(POLL_SEC)
    print(f"nothing after {minutes:g} min")


def hours_event(is_open, value, flip, active):
    if is_open:
        span = f" ({value}{f', until {flip}' if flip else ''})" if value else ""
        return f"OPEN | working hours have started{span}: pick up from <ws>/status.md and each hand-over note"
    who = (f"run `peer wrap-up`: it tells {', '.join(sorted(active))} to finish at the next clean point with a "
           "hand-over note" if active else "no peer is working")
    return (f"CLOSED | working hours are over ({value}; open again {flip}): {who}. Start nothing new; `peer sleep "
            "--idle` as each one finishes, then run `peer watch` again: it waits for opening at no cost.")


def cmd_limits(argv):
    lim = limits()
    if argv[:1] == ["--clear"]:
        gone = [f for f in lim if len(argv) < 2 or f in argv[1].lower()]
        for f in gone:
            del lim[f]
        LIMITS.parent.mkdir(parents=True, exist_ok=True)
        LIMITS.write_text(json.dumps(lim, indent=2) + "\n")
        return print(f"cleared: {', '.join(gone) or 'nothing'}")
    for f, v in sorted(lim.items()):
        print(f"{f:10} {v['text']} (seen {v['seen']})")
    if not lim:
        print("no model is out of usage")


# --- guard hooks (workflow/orca.md § Guard hooks) -------------------------------------------------------------------

def watcher_running():
    try:
        os.kill(int(WATCH_PID.read_text()), 0)
        return True
    except (OSError, ValueError):
        return False


def cmd_hook(argv):
    mode = argv[0] if argv else "prompt"
    try:
        hook = json.load(sys.stdin)
    except ValueError:
        hook = {}
    if mode == "stop" and hook.get("stop_hook_active"):
        return
    peers = REG.exists() and "Runtime: Orca" in project_text()
    reg = load() if peers else {"homes": {}}
    me, term = reg.get("coordinator") or {}, os.environ.get("ORCA_TERMINAL_HANDLE")
    coordinator = (term and term == me.get("terminal")) or (hook.get("session_id") and hook["session_id"] == me.get("session"))
    if peers and not coordinator and (me or term in names(reg)):
        return  # a peer's session, or another session beside the coordinator
    lines = [g for g in [board_guard()] if g]
    if peers and coordinator and reg.get("run"):
        lines += peer_lines(reg)
        is_open, value, flip = hours_now()
        if not is_open and mode == "prompt":  # a note, never a reason to send the turn back
            lines.append(f"Outside working hours ({value}; open again {flip}): the team starts nothing on its own. "
                         "The Owner's own asks still run (`peer dispatch --owner`).")
    if not lines:
        return
    text = "\n".join(lines)
    if mode == "stop":
        print(json.dumps({"decision": "block", "reason": text}))
    else:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": text}}))


def peer_lines(reg):
    run = reg["run"]
    orca("orchestration", "run-use", "--id", run)
    delivery, msgs = pending_batch(run)
    msgs = [m for m in msgs if m.get("type") != "heartbeat"] if delivery else []
    who = names(reg)
    asks = [m for m in msgs if m.get("type") in ("question", "escalation")]
    lines = []
    if asks:
        lines += ["PEER QUESTIONS: each peer waits until you answer with "
                  "`peer tell <home> \"<subject>\" \"<answer>\" --reply <id>`:"] + ["  " + describe(who, m) for m in asks]
    if len(msgs) > len(asks):
        lines += ["Peer reports not handled yet:"] + ["  " + describe(who, m) for m in msgs if m not in asks]
    if msgs:
        mark_seen(msgs)
        lines.append(f"Handle each (a question relayed to the Owner counts once it is on your Waiting on you list), then "
                     f"acknowledge: {PLUGIN}/bin/peer ack {delivery}")
    busy_homes = [home for home, h in sorted(reg["homes"].items()) if h.get("dispatch") and not h.get("asleep") and working(h)]
    if busy_homes and not watcher_running():
        lines.append(f"{len(busy_homes)} peer task(s) in flight ({', '.join(busy_homes)}) and no watcher: start "
                     f"`{PLUGIN}/bin/peer watch 240` in the background so their reports wake you.")
    return lines


# --- list -----------------------------------------------------------------------------------------------------------

def home_state(h):
    """asleep, working, idle, or exited (its Claude session ended; the bare shell is left). Clears a gone terminal."""
    if h.get("asleep"):
        return "asleep"
    if h.get("dispatch") and working(h):
        return "working"
    if h.get("terminal") and not term_info(h):
        h["terminal"] = None
    if not h.get("terminal"):
        return "idle" if h.get("env") and h.get("dispatch") else "asleep"
    return "exited" if session_alive(h) is False else "idle"


def cmd_list(argv):
    _, val, _ = opts(argv, ("--board-json",))
    reg = load()
    for h in reg["homes"].values():
        h["name"] = h.get("name") or pick_name(reg)
    states = {home: home_state(h) for home, h in reg["homes"].items()}
    save(reg)
    if val.get("--board-json"):
        # One Owner-board peers row per home, for ArtifactData file_path (workflow/board.md § Data).
        out = Path(val["--board-json"]) / "peers"
        out.mkdir(parents=True, exist_ok=True)
        ranked = sorted(reg["homes"].items(), key=lambda x: (ROLE_RANK.get(x[1]["role"], 9), x[0]))
        for n, (home, h) in enumerate(ranked, 1):
            st, task = states[home], h.get("title") or ""
            doing = task if st == "working" else f"{'Asleep' if st in ('asleep', 'exited') else 'Idle'}" + \
                (f" · last: {task}" if task and task != "(adopted)" else "")
            (out / f"{home}.json").write_text(json.dumps({"name": h["name"], "role": h["role"], "doing": doing,
                                                          "order": n}, indent=2, ensure_ascii=False) + "\n")
        return print(f"wrote {len(ranked)} peers row(s) to {out}")
    print(f"run: {reg.get('run') or 'none yet'}")
    for home, h in sorted(reg["homes"].items()):
        model = f"{h.get('model') or '?'}/{h.get('effort') or '?'}" + (" (this task)" if h.get("once") else "")
        where = f"@{h['env']}" if h.get("env") else Path(h.get("worktree") or "?").name
        print(f"{home:14} {h['name']:8} {h['role']:19} {states[home]:8} {model:24} {where:24} {h.get('title', '')} "
              f"({h.get('since', '?')})")
    for f, v in sorted(limits().items()):
        print(f"out of usage: {f} — {v['text']}")


def cmd_team(argv):
    """The team Team setup names: who is who, and each home's worktree. --create makes the missing worktrees now:
    worktrees only, since every task starts a fresh session and one started early would only be replaced."""
    pos, val, on_ = opts(argv, ("--rename",), ("--create",))
    reg = load()
    named = team_homes()
    if val.get("--rename"):
        home = val["--rename"]
        h = reg["homes"].get(home) or die(f"no home {home} yet: `peer team --create` or its first dispatch makes it")
        if len(pos) != 1 or not re.fullmatch(r"[A-Z][\w'-]{0,19}", pos[0]):
            die("peer team --rename <home> <name>: one name, starting with a capital letter")
        h.update(name=pos[0], labelled=None)
        label_worktree(home, h)
        save(reg)
        return print(f"{home} is now {label(home, h)}")
    if "--create" in on_:
        if not named:
            die("the dev-team section has no Team setup § Homes rule naming the homes; /dev-team:orca recommended "
                "writes one. Without it, each home is made by its first dispatch.")
        for home in named:
            if (reg["homes"].get(home) or {}).get("worktree"):
                continue
            role = home_role(home) or die(f"{home}: can't tell its role from the name; its first dispatch makes it")
            path = new_worktree("new-top-level", home, None)[len("path:"):]
            reg["homes"][home] = {"role": role, "terminal": None, "worktree": path, "dispatch": None, "title": "",
                                  "since": time.strftime("%Y-%m-%d %H:%M"), "asleep": True, "env": None,
                                  "name": pick_name(reg)}
            label_worktree(home, reg["homes"][home])
            save(reg)
            print(f"{home}: made {path}; no session until its first task")
    for h in reg["homes"].values():
        h["name"] = h.get("name") or pick_name(reg)
    for home, h in reg["homes"].items():
        label_worktree(home, h)
    save(reg)
    for home in named + sorted(set(reg["homes"]) - set(named)):
        h = reg["homes"].get(home)
        if h:
            print(f"{home:14} {label(home, h):28} {home_state(h):8} {h.get('worktree') or '?'}")
        else:
            print(f"{home:14} {'':28} {'not made':8} its first dispatch, or `peer team --create`, makes it")
    save(reg)


CMDS = {"dispatch": cmd_dispatch, "tell": cmd_tell, "nudge": cmd_nudge, "switch": cmd_switch, "sleep": cmd_sleep, "release": cmd_sleep,
        "adopt": cmd_adopt, "watch": cmd_watch, "pending": cmd_pending, "ack": cmd_ack, "pr": cmd_pr, "prs": cmd_prs,
        "sizes": cmd_sizes, "limits": cmd_limits, "list": cmd_list, "team": cmd_team, "board-stamp": cmd_board_stamp,
        "hook": cmd_hook, "wrap-up": cmd_wrap_up}

# What a peer may run itself: reading the team's state, and the hooks every session runs. The rest act for the coordinator.
PEER_OK = {"sizes", "limits", "list", "prs", "hook", "nudge"}


def peer_home():
    """The home whose terminal this is, when a peer runs peer."""
    me = os.environ.get("ORCA_TERMINAL_HANDLE")
    return next((n for n, h in load()["homes"].items() if me and h.get("terminal") == me), None) if REG.exists() else None


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        die(__doc__)
    if sys.argv[1] not in PEER_OK and (home := peer_home()):
        die(f"this is {home}'s terminal: `peer {sys.argv[1]}` is the coordinator's. To reach another peer, send the "
            "coordinator a status message saying who it is for and what to tell them; it passes it on.")
    CMDS[sys.argv[1]](sys.argv[2:])
