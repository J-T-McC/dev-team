#!/bin/bash
# seed-drift [project-dir] — what the plugin's seeds have that this project's copies lack (commands/sync.md step 4).
# Reports seed sections missing from <ws>/standards/*.md, workspace seed files and seed rules missing from the
# dev-team section, outdated Orca Runtime-line settings, and links inside the workspace to a folder that holds them.
# Prints one line per finding (exit 1), or "up to date" (exit 0).
P=${1:-.}
PLUGIN=$(cd "$(dirname "$0")/.." && pwd)
source "$PLUGIN/bin/_workspace.sh" "$P"
found=0
say() { echo "$1"; found=1; }
norm() { sed -e 's/^## *//' -e 's/ *(.*) *$//' | tr '[:upper:]' '[:lower:]'; }

# 1. Standards: seed "## " sections the project's copy lacks. "(active)" and case don't count.
for seed in "$PLUGIN"/seeds/standards/*.md; do
  f="$P/$WS/standards/$(basename "$seed")"
  [ -f "$f" ] || continue
  have=$(grep '^## ' "$f" | norm)
  while IFS= read -r h; do
    printf '%s\n' "$have" | grep -qxF "$(printf '%s\n' "$h" | norm)" ||
      say "standards/$(basename "$seed"): missing section \"${h#\#\# }\""
  done < <(grep '^## ' "$seed")
done

# 2. The dev-team section: seed rules (bold labels under "## Rules") it lacks. Guest mode keeps it in CLAUDE.local.md.
section="$P/CLAUDE.md"
grep -qs '\*\*Workspace:\*\*' "$P/CLAUDE.local.md" && section="$P/CLAUDE.local.md"
if grep -qs -e '^# Development Organization' -e '\*\*Workspace:\*\*' "$section"; then
  # Workspace files sync copies (commands/sync.md step 3), e.g. one added to the plugin since bootstrap.
  for pair in stack.md:stack/stack.md status.md:status.md status-done.md:status-done.md triage.md:triage.md \
              backlog-index.md:backlog/index.md backlog-archive.md:backlog/archive.md friction-log.md:friction-log.md; do
    [ -e "$P/$WS/${pair#*:}" ] || say "$WS/${pair#*:}: missing file (seed ${pair%%:*})"
  done
  # HTML comments in workspace Markdown: Orca shows such a file as raw text (workflow/workspace.md). A template a role
  # fills in (*.tmpl.md) keeps its comments: they are notes to the filler that must not reach the reader.
  while IFS= read -r f; do
    say "${f#$P/}: an HTML comment (<!-- -->): Orca shows the file as raw text; make it a plain line"
  done < <(find "$P/$WS" "$P/$FEATURES" -name '*.md' -not -name '*.tmpl.md' -not -path '*/.git/*' \
             -exec grep -l -- '<!--' {} + 2>/dev/null | sort -u)
  # status.md as the seed now keeps it: a Next column, so the Phase cell holds only the phase; no approvals history.
  st="$P/$WS/status.md"
  if grep -qs '^| *Feature *|' "$st"; then
    grep -qs '^| *Feature *|.*| *Next *|' "$st" ||
      say "$WS/status.md: no Next column (seed status.md): the next step goes there, and the Phase cell holds only the phase"
    grep -qs '^## Approvals' "$st" &&
      say "$WS/status.md: an approvals history — each approval's record is the Approved by line in its artifact; the Approvals cell names only the gates passed (seed status.md)"
  fi
  [ -e "$P/$WS/status-done.md" ] && ! grep -qs '^## Fixes' "$P/$WS/status-done.md" &&
    say "$WS/status-done.md: no Fixes section (seed status-done.md): each fast-path fix gets a row there when it merges"
  orca=$(grep -s 'Runtime: Orca' "$section")
  label() { sed -n 's/^- \*\*\([^*:.]*\)[:.].*/\1/p' | sed 's/ *(.*) *$//'; }  # a note in brackets is not drift
  have=$(label < "$section")
  while IFS= read -r l; do
    # Under the Orca runtime the Runtime line replaces the in-conversation rule.
    [ -n "$orca" ] && [ "$l" = "Run roles in this conversation" ] && continue
    printf '%s\n' "$have" | grep -qxF "$l" || say "$(basename "$section"): missing rule \"$l\""
  done < <(sed -n '/^## Rules/,/^## /p' "$PLUGIN/seeds/CLAUDE.project.md" | label)

  # The recommended Orca setup, when the project took it: rules its Team setup section lacks.
  if grep -qs '^## Team setup' "$section"; then
    have=$(sed -n '/^## Team setup/,/^## /p' "$section" | label)
    while IFS= read -r l; do
      hint="dev-team workflow/orca-recommended.md"
      [ "$l" = Workspace ] && hint="committed or not, as dev-team commands/orca.md step 4 writes it"
      printf '%s\n' "$have" | grep -qxF "$l" || say "$(basename "$section"): Team setup has no \"$l\" rule ($hint)"
    done < <(sed -n '/^## Team setup/,$p' "$PLUGIN/seeds/orca-recommended.md" | label)
  fi

  # 3. The Orca Runtime line: settings renamed or added since the project wrote it (workflow/orca.md § Opt in).
  if [ -n "$orca" ]; then
    case "$orca" in *"Peer clear threshold"*)
      say "Runtime line: \"Peer clear threshold\" is now \"Peer size limit: 400k\" (a fresh session per task; the limit is the mid-task safety net)" ;;
    *"Peer size limit"*) ;;
    *) say "Runtime line: no \"Peer size limit\" (400k applies)" ;;
    esac
    case "$orca" in *"Worktree cards:"*) ;;
    *"Board:"*) say "Runtime line: \"Board:\" is now \"Worktree cards:\" — it switches only Orca's worktree cards; the Owner board is the **Owner board:** line (workflow/board.md)" ;;
    *) say "Runtime line: no \"Worktree cards:\" setting (off applies)" ;;
    esac
    case "$orca" in *"Team model:"*) ;; *) say "Runtime line: no \"Team model:\" setting — peers will not launch until it names one (workflow/orca.md § Launch settings)" ;; esac
    case "$orca" in *"Fallback model:"*) ;; *) say "Runtime line: no \"Fallback model:\" setting (none applies)" ;; esac
    case "$orca" in *"Advisor:"*) ;; *) say "Runtime line: no \"Advisor:\" setting (none applies)" ;; esac
  fi
fi

# 4. Links inside the workspace to a folder that contains them — the workspace, a folder above it, or one on the way
# down: every tool that walks the workspace loops on them.
if [ -d "$P/$WS" ]; then
  while IFS= read -r l; do
    target=$(readlink "$l") || continue  # read before any cd: $l may be relative to where we started
    here=$(cd "$(dirname "$l")" 2>/dev/null && pwd -P) || continue
    t=$(cd "$here" && cd "$target" 2>/dev/null && pwd -P) || continue
    case "$here/" in "${t%/}"/*) say "${l#"$P"/}: links to a folder that contains it ($target) — remove the link" ;; esac
  done < <(find "$P/$WS" -type l 2>/dev/null)
fi

[ $found = 0 ] && echo "up to date"
exit $found
